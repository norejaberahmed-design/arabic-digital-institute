# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/arabic_digital_institute?schema=public"

# Better Auth: generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Android app: set this to the reachable URL of the deployed web/API server,
# or your computer's LAN IP when testing on a physical phone.
EXPO_PUBLIC_API_URL="http://192.168.1.10:3000"
