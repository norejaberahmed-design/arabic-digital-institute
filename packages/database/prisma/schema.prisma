generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url       = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("LEARNER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  learnerProfile LearnerProfile?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  language    String   @default("ar")
  instructionLanguage String @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  levels      Level[]
}

model Level {
  id          String           @id @default(cuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String
  position    Int
  lessons     Lesson[]
  @@unique([courseId, code])
  @@index([courseId, position])
}

model Lesson {
  id          String            @id @default(cuid())
  levelId     String
  level       Level             @relation(fields: [levelId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  summary     String
  objective   String
  durationMin Int               @default(7)
  status      String            @default("DRAFT")
  position    Int
  content     Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  progress    LessonProgress[]
  attempts    ActivityAttempt[]
  @@unique([levelId, slug])
  @@index([levelId, status, position])
}

model LearnerProfile {
  id          String   @id @default(cuid())
  authSubject String   @unique
  user        User     @relation(fields: [authSubject], references: [id], onDelete: Cascade)
  displayName String?
  interfaceLanguage String @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  progress    LessonProgress[]
  attempts    ActivityAttempt[]
}

model LessonProgress {
  id             String   @id @default(cuid())
  learnerId      String
  learner        LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed      Boolean  @default(false)
  lastPosition   Int      @default(0)
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt
  @@unique([learnerId, lessonId])
  @@index([learnerId, updatedAt])
}

model ActivityAttempt {
  id          String   @id @default(cuid())
  learnerId   String
  learner     LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityId  String
  answer      Json
  isCorrect   Boolean
  feedback    String?
  createdAt   DateTime @default(now())
  @@index([learnerId, lessonId, createdAt])
}
